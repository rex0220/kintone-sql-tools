{
  "version": 1,
  "defaultProfile": "dev",
  "profiles": {
    "dev": {
      "baseUrl": "https://example.kintone.com",
      "auth": "token",
      "app": 100,
      "allowPhysicalAppRefs": true,
      "logicalApps": {
        "ORDERS": 100,
        "CUSTOMERS": 101
      },
      "tokenMap": {
        "APP100": "env:KSQL_TOKEN_APP100",
        "APP101": "env:KSQL_TOKEN_APP101"
      },
      "query": {
        "maxRecords": 500,
        "maxConcurrent": 10,
        "cursorMaxActive": 2,
        "onLimit": "error",
        "timeout": 30000
      },
      "output": {
        "format": "table",
        "pretty": false,
        "noHeader": false,
        "noColor": false,
        "quiet": false,
        "exitOnEmpty": false,
        "userFormat": "name",
        "arrayFormat": "join",
        "tableFormat": "count",
        "dateFormat": "local",
        "attachmentFormat": "name"
      }
    },
    "guest": {
      "baseUrl": "https://example.kintone.com",
      "guestSpaceId": 5,
      "auth": "token",
      "app": 200,
      "allowPhysicalAppRefs": true,
      "logicalApps": {
        "ORDERS": 200,
        "CUSTOMERS": 201
      },
      "tokenMap": {
        "APP200": "env:KSQL_TOKEN_APP200",
        "APP201": "env:KSQL_TOKEN_APP201"
      },
      "query": {
        "maxRecords": 500,
        "maxConcurrent": 10,
        "cursorMaxActive": 2,
        "onLimit": "error",
        "timeout": 30000
      },
      "output": {
        "format": "table",
        "pretty": false,
        "noHeader": false,
        "noColor": false,
        "quiet": false,
        "exitOnEmpty": false,
        "userFormat": "name",
        "arrayFormat": "join",
        "tableFormat": "count",
        "dateFormat": "local",
        "attachmentFormat": "name"
      }
    }
  }
}
